Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # i file non si servono mai direttamente: si passa da media.php
  RewriteRule ^(storage|data|inc)/ - [F,L]
</IfModule>

<FilesMatch "\.(db|sqlite|sqlite3|log|md)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# upload generosi dove l'hosting lo consente (comunque carichiamo a blocchi)
<IfModule mod_php.c>
  php_value upload_max_filesize 64M
  php_value post_max_size 68M
  php_value max_execution_time 300
</IfModule>
